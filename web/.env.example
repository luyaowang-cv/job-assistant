# Local PostgreSQL started by ../docker-compose.yml
DATABASE_URL="postgresql://job_assistant:job_assistant_dev_password@127.0.0.1:5432/job_assistant?schema=public"

# better-auth 会话签名密钥。生成：openssl rand -base64 32
# BETTER_AUTH_SECRET=

# 站点对外地址。邮件里的验证/重置链接由它拼成——不设会生成打不开的相对链接。
# 生产填公网域名（compose 里已固定为 https://offerscoming.cn），本地开发用默认值即可。
# BETTER_AUTH_URL=http://localhost:3000

# 所有者账号（仅用于 pnpm auth:bootstrap 一次性初始化）
# OWNER_EMAIL=
# OWNER_PASSWORD=

# 公开注册总开关：设为 true 才开放自助注册（未设置默认关闭）。
# ALLOW_PUBLIC_SIGNUP=true

# 管理员邮箱列表（逗号分隔）。这些账号可下线/删除/导入岗位，普通用户只读。
# ADMIN_EMAILS=you@example.com

# BYOK：加密用户自带 API Key（可选，缺省回退 FEISHU_TOKEN_ENCRYPTION_KEY）。生成：openssl rand -base64 32
# AI_KEY_ENCRYPTION_KEY=

# Shared server-side key for later OpenAI-compatible Agent integration.
# This key never enters the browser, database or extension. Do not commit real keys.
# OPENAI_API_KEY=

# Server-only Feishu self-built app credentials for job-library synchronization.
# Grant the app read access to each shared Bitable; never expose these values to the browser.
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/integrations/feishu/callback
# Required to encrypt stored OAuth tokens. Generate with `openssl rand -base64 32`.
# FEISHU_TOKEN_ENCRYPTION_KEY=
# Set to false only when you need to suspend the built-in daily 08:00 Asia/Shanghai job sync.
# FEISHU_AUTO_SYNC_ENABLED=true

# 邮件发信（SMTP）。刻意写成服务商无关的配置：Resend、阿里云邮件推送、QQ 邮箱
# 等任何提供 SMTP 的服务都能用，换服务商只改这几行，不动代码。
# 未配置 SMTP_HOST 时所有发信降级为打日志——注册与找回密码流程仍可正常走完。
# Resend 示例：host=smtp.resend.com / port=465 / secure=true / user=resend（字面量，不是邮箱）
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# 发件人。域名必须在发信服务商侧完成验证（SPF/DKIM），否则会被拒收或进垃圾箱。
# 注意：部分服务商的用户名不是邮箱，那种情况下本项必须显式配置。
# SMTP_FROM="Offer来 <no-reply@offerscoming.cn>"
# 本地开发置 true：不真正发信，把邮件正文（含验证链接）打到终端，方便点链接调试。
# MAIL_DEV_LOG_ONLY=true
